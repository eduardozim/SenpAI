# ==============================================================================
# MÍDIAS E VÍDEOS DE TESTE / PROCESSADOS
# ==============================================================================
*.mp4
*.avi
*.mov
*.mkv
*.webm
output_annotated.mp4
output_annotated_*.mp4

# ==============================================================================
# ARQUIVOS DE LOG E DEPURAÇÃO
# ==============================================================================
*.log
logs/*.log
*.tfevents.*

# ==============================================================================
# ARQUIVOS COMPILADOS PYTHON & AMBIENTE VIRTUAL
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.pytest_cache/
.coverage
htmlcov/
.venv/
.venv*/
env/
venv/
ENV/
env.bak/
venv.bak/
.streamlit/secrets.toml

# ==============================================================================
# ARQUIVOS GERADOS PELO TREINAMENTO DE VISÃO COMPUTACIONAL (USUÁRIO)
# ==============================================================================
# Execuções de treinamento e pesos gerados pelo YOLO / Ultralytics
runs/
weights/
.ultralytics/

# Modelos neurais devem ser armazenados exclusivamente em models/ (proibidos na raiz)
/*.pt
/*.onnx
/*.bin

# Checkpoints e modelos customizados gerados durante o treino
models/checkpoints/
models/trained/
models/custom/
models/*_trained.pt
models/best.pt
models/last.pt

# Motores compilados no hardware local do usuário (ex: TensorRT CUDA)
*.engine

# Logs de experimentos e tracking de treino
wandb/
.wandb/
lightning_logs/
tensorboard/

# Caches de labels/dataset gerados durante o processamento do treino
*.cache
*.cache.npy

# Sessões temporárias e execuções de treino geradas pelo usuário
data/training_runs/
data/checkpoints/
data/test_*.json
data/tmp/
data/uploads/
data/feature_cache/
data/weak_labels/
data/flag_dataset/
data/models/*/runs/
data/models/**/*.pt

# Serializações e dumps temporários de treino
*.joblib
*.pkl
*.pickle

# Scratch scripts e temporários de análise
scratch/

# Documentação interna de referência e melhorias
REFERENCIA_MOTOR_CALIBRACAO_E_APRENDIZADO.md
Melhorias_Issues.md


# Arquivos do sistema operacional (Windows / macOS)
desktop.ini
Thumbs.db
.DS_Store

# Pasta única de vídeos (lutas, treinos e vídeos baixados pela coleta)
data/videos/
data/internet/baixando/
data/internet/atividade.jsonl
data/internet/regras_texto/
data/internet/textos.json
data/backups/

# Chaves de API da coleta (só neste computador)
config/api_keys.local.json

# Histórico de evolução dos kenshis (nomes de pessoas: fica só neste computador)
data/training_progress.json
