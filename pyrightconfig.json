{
  "include": [
    "src",
    "tests",
    "app.py",
    "main.py",
    "run_tests.py"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv"
  ],
  "extraPaths": [
    ".",
    "src",
    ".venv/Lib/site-packages"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "reportMissingImports": "none",
  "reportMissingTypeStubs": "none"
}
